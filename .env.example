# Copy to .env and fill in your own values. Never commit .env.
# Placeholders only: there are no real credentials in this file.

# Local MySQL (docker compose service "db", host port 3307)
MYSQL_DATABASE=pragmattie_pmo
MYSQL_USER=pmo
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# API settings (read by apps/api/app/config.py). Under docker compose the API gets the DB_*
# values from the MYSQL_* ones above. Running the API outside Docker against the compose
# database, set the parts below; the password may contain any character, it is URL-encoded.
APP_ENV=dev
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=pmo
DB_PASSWORD=change-me
DB_NAME=pragmattie_pmo
# Or give a full URL instead of the DB_* parts (it wins if both are set). Percent-encode
# special characters in the password yourself: @ is %40, : is %3A, / is %2F, # is %23.
# DATABASE_URL=mysql+pymysql://pmo:change-me@127.0.0.1:3307/pragmattie_pmo

# Hosted database (Aiven for MySQL, TLS required): the CA certificate as a file path or as
# the PEM text. Leave unset for local MySQL and SQLite.
# DATABASE_CA_CERT=/path/to/aiven-ca.pem

# Required outside tests, and at least 32 bytes everywhere. Left empty on purpose: startup
# stops until you set a real one. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Session cookies are Secure by default. Local development over plain http only: uncomment to
# turn that off (docker-compose.yml already does this for its api service). Never in hosting.
# COOKIE_SECURE=false

# Request bodies over this many bytes get 413 (default 64 KiB).
# MAX_BODY_BYTES=65536

# Needed only when AGENT_MODE is shadow or enforce: off refuses every agent run.
# ANTHROPIC_API_KEY=
AGENT_MODE=off
# The risk agent's model, output cap and prices (US dollars per million tokens).
# RISK_AGENT_MODEL=claude-sonnet-5-5
# RISK_AGENT_MAX_TOKENS=4096
# RISK_AGENT_INPUT_USD_PER_MTOK=2
# RISK_AGENT_OUTPUT_USD_PER_MTOK=10
# Governance policy files; defaults to policies/ at the repository root.
# POLICIES_DIR=/path/to/policies
CORS_ORIGINS=http://localhost:5173

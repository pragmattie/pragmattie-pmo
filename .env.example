# Copy to .env and fill in your own values. Never commit .env.
# Placeholders only: there are no real credentials in this file.

# Local MySQL (docker compose service "db", host port 3307)
MYSQL_DATABASE=pragmattie_pmo
MYSQL_USER=pmo
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# API settings (read by apps/api/app/config.py). Under docker compose the API gets the DB_*
# values from the MYSQL_* ones above. Running the API outside Docker against the compose
# database, set the parts below; the password may contain any character, it is URL-encoded.
APP_ENV=dev
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=pmo
DB_PASSWORD=change-me
DB_NAME=pragmattie_pmo
# Or give a full URL instead of the DB_* parts (it wins if both are set). Percent-encode
# special characters in the password yourself: @ is %40, : is %3A, / is %2F, # is %23.
# DATABASE_URL=mysql+pymysql://pmo:change-me@127.0.0.1:3307/pragmattie_pmo

# Hosted database (Aiven for MySQL, TLS required): the CA certificate as a file path or as
# the PEM text. Leave unset for local MySQL and SQLite.
# DATABASE_CA_CERT=/path/to/aiven-ca.pem

# Required outside tests. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value

# Optional until the agents arrive.
# ANTHROPIC_API_KEY=
AGENT_MODE=off
CORS_ORIGINS=http://localhost:5173

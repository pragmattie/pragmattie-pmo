# Copy to .env and fill in your own values. Never commit .env.
# Placeholders only: there are no real credentials in this file.

# Local MySQL (docker compose service "db", host port 3307)
MYSQL_DATABASE=pragmattie_pmo
MYSQL_USER=pmo
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# API settings (read by apps/api/app/config.py). Running the API outside Docker against the
# compose database: mysql+pymysql://pmo:<MYSQL_PASSWORD>@127.0.0.1:3307/pragmattie_pmo
PMO_DATABASE_URL=mysql+pymysql://pmo:change-me@127.0.0.1:3307/pragmattie_pmo
